# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Resend (server only). Verify the sender domain in Resend before enabling the queue.
RESEND_API_KEY=
EMAIL_FROM="Paras <hello@your-verified-domain.com>"
REPLY_TO_EMAIL=
CASE_STUDY_URL=
APP_URL=http://localhost:3000
CRON_SECRET=
DAILY_SEND_LIMIT=400
SEND_INTERVAL_SECONDS=90

# Campaign signature and meeting options (server only).
SENDER_NAME=Paras
SENDER_ROLE="Meta Ads & Lead Generation"
SENDER_LOCATION="Gurugram, India"
SENDER_EMAIL=
SENDER_PHONE=
MEETING_OPTION_1="Tuesday at 11:00 AM IST"
MEETING_OPTION_2="Thursday at 3:00 PM IST"

# Supabase (server only; never use an anon key here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password requested by the dashboard before it can generate or send.
# Use a long, unique value. Do NOT prefix with NEXT_PUBLIC_.
DASHBOARD_PASSWORD=
